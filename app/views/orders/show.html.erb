<% content_for :title, "Order ##{@order.id}" %>

<header class="page-head">
  <p class="eyebrow">Account</p>
  <h1 class="page-title">Order <em>#<%= @order.id %></em></h1>
</header>

<div class="panel">
  <div class="flex-between mb-1">
    <h2 class="panel-title" style="margin:0;">Items</h2>
    <span class="status-pill <%= order_status_pill_class(@order.order_state) %>"><%= @order.order_state.humanize %></span>
  </div>

  <div class="table-wrap mb-1">
    <table class="data-table">
      <thead>
        <tr><th>Card</th><th>Qty</th><th class="text-right">Price</th></tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr>
            <td><%= item.product.name %></td>
            <td class="num"><%= item.quantity %></td>
            <td class="num text-right"><%= number_to_currency(item.price) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="totals" style="max-width: 320px; margin-left: auto;">
    <% { "GST" => @order.gst, "PST" => @order.pst, "HST" => @order.hst, "QST" => @order.qst }.each do |label, amount| %>
      <% next if amount.to_f.zero? %>
      <li><span><%= label %></span><span class="num"><%= number_to_currency(amount) %></span></li>
    <% end %>
    <li class="grand"><span>Total</span><span class="num"><%= number_to_currency(@order.calculate_order_total) %></span></li>
  </ul>
</div>
