<article class="product-card">
  <div class="pc-media">
    <div class="pc-flags">
      <% if product.sale %>
        <span class="badge badge-sale">Sale</span>
      <% else %>
        <span></span>
      <% end %>
      <% if product.respond_to?(:staple) && product.staple %>
        <span class="badge badge-gold">Staple</span>
      <% end %>
    </div>
    <%= image_tag product.image_url.presence || "placeholder.png", alt: product.name, loading: "lazy" %>
  </div>
  <div class="pc-body">
    <p class="pc-type"><%= product.card_type %></p>
    <h3 class="pc-name"><%= link_to product.name, product_path(product) %></h3>
    <div class="pc-foot">
      <span class="pc-price-label">Market</span>
      <span class="pc-price"><%= number_to_currency(product.price) %></span>
    </div>
  </div>
</article>
