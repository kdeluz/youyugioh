<%
  eyebrow, title_html, subtitle =
    case params[:action]
    when "category"
      ["Category", "#{h(params[:category])} <em>singles</em>".html_safe, "Every #{params[:category].to_s.downcase} currently in the vault."]
    when "sale"
      ["Limited time", "On <em>sale</em>".html_safe, "Marked-down singles — gone when they're gone."]
    when "new_products"
      ["Fresh pulls", "New <em>arrivals</em>".html_safe, "Cards added to the shop in the last three days."]
    when "recently_updated"
      ["Restocked", "Recently <em>updated</em>".html_safe, "Listings with fresh prices or stock changes."]
    when "search"
      ["Search", "Results for <em>#{h(params[:keyword].presence || 'all cards')}</em>".html_safe,
       params[:category].present? ? "Filtered to #{params[:category]}." : "Across every category in the shop."]
    else
      ["The vault", "Every card, <em>market priced</em>".html_safe, "Browse singles across every set — staples, chase cards and budget picks."]
    end
%>

<% content_for :title, strip_tags(title_html.to_s) %>

<header class="page-head">
  <p class="eyebrow"><%= eyebrow %></p>
  <h1 class="page-title"><%= title_html %></h1>
  <p class="lede"><%= subtitle %></p>
</header>

<div class="toolbar">
  <span class="result-count"><%= pluralize(number_with_delimiter(@products.total_count), "card") %> · page <%= @products.current_page %> of <%= [@products.total_pages, 1].max %></span>
  <div class="select-pill">
    <select onchange="window.location.href=this.value;" aria-label="Sort products">
      <option value="<%= url_for(request.query_parameters.except('sort', 'page')) %>" <%= "selected" if params[:sort].blank? %>>Sort: Featured</option>
      <option value="<%= url_for(request.query_parameters.except('page').merge(sort: 'alphabetical')) %>" <%= "selected" if params[:sort] == 'alphabetical' %>>Sort: A–Z</option>
      <option value="<%= url_for(request.query_parameters.except('page').merge(sort: 'price_high_low')) %>" <%= "selected" if params[:sort] == 'price_high_low' %>>Sort: Price high–low</option>
      <option value="<%= url_for(request.query_parameters.except('page').merge(sort: 'price_low_high')) %>" <%= "selected" if params[:sort] == 'price_low_high' %>>Sort: Price low–high</option>
    </select>
  </div>
  <% if params[:sort].present? || params[:keyword].present? || params[:action] != "index" %>
    <%= link_to "Clear filters", root_path, class: "btn btn-ghost btn-sm" %>
  <% end %>
</div>

<% if @products.any? %>
  <div class="product-grid">
    <%= render partial: "product", collection: @products %>
  </div>

  <%= paginate @products %>
<% else %>
  <div class="empty-state">
    <div class="glyph">◇</div>
    <h3>No cards found</h3>
    <p>Nothing in the vault matches this filter. Try another search or browse the full collection.</p>
    <%= link_to "Browse all cards", root_path, class: "btn btn-primary" %>
  </div>
<% end %>
