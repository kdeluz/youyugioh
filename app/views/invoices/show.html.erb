<% content_for :title, "Invoice #{@invoice.invoice_number}" %>

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <%= link_to "Order history", invoices_path %>
  <span class="sep">/</span>
  <span><%= @invoice.invoice_number %></span>
</nav>

<header class="page-head">
  <p class="eyebrow">Invoice</p>
  <div class="flex-between">
    <h1 class="page-title" style="margin:0;"><em>#</em><%= @invoice.invoice_number %></h1>
    <span class="status-pill <%= order_status_pill_class(@invoice.order.order_state) %>"><%= @invoice.order.order_state.humanize %></span>
  </div>
</header>

<div class="panel">
  <h2 class="panel-title">Order details</h2>
  <dl class="meta-list">
    <div>
      <dt>Order</dt>
      <dd>#<%= @invoice.order.id %></dd>
    </div>
    <div>
      <dt>Placed</dt>
      <dd><%= @invoice.created_at.strftime("%B %-d, %Y · %-l:%M %p") %></dd>
    </div>
    <div>
      <dt>Invoice status</dt>
      <dd><%= @invoice.invoice_state.humanize %></dd>
    </div>
    <div>
      <dt>Ships to</dt>
      <dd><%= [@invoice.order.address_line1, @invoice.order.city, @invoice.order.province, @invoice.order.postal_code, @invoice.order.country].compact_blank.join(", ") %></dd>
    </div>
  </dl>
</div>

<div class="panel">
  <h2 class="panel-title">Items</h2>
  <div class="table-wrap mb-1">
    <table class="data-table">
      <thead>
        <tr><th>Card</th><th>Qty</th><th class="text-right">Price</th></tr>
      </thead>
      <tbody>
        <% @invoice.order.order_items.each do |item| %>
          <tr>
            <td><%= item.product.name %></td>
            <td class="num"><%= item.quantity %></td>
            <td class="num text-right"><%= number_to_currency(item.price) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="totals" style="max-width: 320px; margin-left: auto;">
    <% { "GST" => @invoice.gst, "PST" => @invoice.pst, "HST" => @invoice.hst, "QST" => @invoice.qst }.each do |label, amount| %>
      <% next if amount.to_f.zero? %>
      <li><span><%= label %></span><span class="num"><%= number_to_currency(amount) %></span></li>
    <% end %>
    <li class="grand"><span>Total</span><span class="num"><%= number_to_currency(@invoice.total) %></span></li>
  </ul>
</div>
