<% content_for :title, "Order History" %>

<header class="page-head">
  <p class="eyebrow">Account</p>
  <h1 class="page-title">Order <em>history</em></h1>
  <p class="lede">Every past order with its status and total. Open one for the full invoice, taxes and shipping details.</p>
</header>

<% invoices = @invoices.order(created_at: :desc) %>

<% if invoices.none? %>
  <div class="empty-state">
    <div class="glyph">◇</div>
    <h3>Nothing here yet</h3>
    <p>Once you place an order, its invoice will land here.</p>
    <%= link_to "Browse the vault", root_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Invoice</th>
          <th>First item</th>
          <th>Placed</th>
          <th class="text-right">Total</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% invoices.each do |invoice| %>
          <tr>
            <td class="num"><%= invoice.invoice_number %></td>
            <td>
              <% first_item = invoice.order.order_items.first %>
              <% if first_item&.product %>
                <%= truncate(first_item.product.name, length: 34) %>
                <% if (extra = invoice.order.order_items.size - 1) > 0 %>
                  <span class="text-muted">+<%= extra %> more</span>
                <% end %>
              <% else %>
                <em class="text-muted">No product found</em>
              <% end %>
            </td>
            <td class="num"><%= invoice.created_at.strftime("%b %-d, %Y") %></td>
            <td class="num text-right"><%= number_to_currency(invoice.total) %></td>
            <td><span class="status-pill <%= order_status_pill_class(invoice.order.order_state) %>"><%= invoice.order.order_state.humanize %></span></td>
            <td class="text-right"><%= link_to "View", invoice_path(invoice), class: "btn btn-ghost btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
