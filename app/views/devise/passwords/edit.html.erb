<% content_for :title, "Change Password" %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1 class="auth-title">Change your password</h1>
    <p class="auth-sub">Pick something strong — your collection is worth protecting.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field">
        <%= f.label :password, "New password", class: "label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "input" %>
        <% if @minimum_password_length %>
          <p class="help"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirm new password", class: "label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
      </div>

      <%= f.submit "Change my password", class: "btn btn-primary btn-block" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
