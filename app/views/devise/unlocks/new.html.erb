<% content_for :title, "Resend Unlock Instructions" %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1 class="auth-title">Unlock your account</h1>
    <p class="auth-sub">We'll email you instructions to unlock it.</p>

    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email, class: "label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
      </div>

      <%= f.submit "Resend unlock instructions", class: "btn btn-primary btn-block" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
